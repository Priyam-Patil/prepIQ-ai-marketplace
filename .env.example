# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# PostgreSQL (runtime and Prisma CLI)
DATABASE_URL=
DIRECT_URL=

# Stream: public application key and server-only secret
NEXT_PUBLIC_STREAM_API_KEY=
STREAM_SECRET_KEY=

# Server-only Gemini API key
GEMINI_API_KEY=

# Server-side Arcjet protection
ARCJET_KEY=

# Resend email notifications (server-only except the app's public URL)
RESEND_API_KEY=
ADMIN_EMAIL=
EMAIL_FROM=
EMAIL_CRON_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
