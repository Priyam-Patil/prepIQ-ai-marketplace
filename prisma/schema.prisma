
generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ───────────────────────────────────────────────

enum UserRole {
  UNASSIGNED
  INTERVIEWEE
  INTERVIEWER
}

enum BookingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AvailabilityStatus {
  AVAILABLE
  BOOKED
  BLOCKED
}

enum PayoutStatus {
  PROCESSING
  PROCESSED
}

enum InterviewCategory {
  FRONTEND
  BACKEND
  FULLSTACK
  DSA
  SYSTEM_DESIGN
  BEHAVIORAL
  DEVOPS
  MOBILE
}

enum FeedbackRating {
  POOR
  AVERAGE
  GOOD
  EXCELLENT
}

enum TransactionType {
  CREDIT_PURCHASE
  BOOKING_DEDUCTION
  BOOKING_EARNING
  ADMIN_ADJUSTMENT
}

// ─── USER ────────────────────────────────────────────────

model User {
  id          String   @id @default(uuid())
  clerkUserId String   @unique
  email       String   @unique
  name        String?
  imageUrl    String?
  role        UserRole @default(UNASSIGNED)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Interviewee-only
  credits                Int       @default(0)
  currentPlan            String    @default("free")
  creditsLastAllocatedAt DateTime?

  // Interviewer-only
  bio           String?
  title         String?
  company       String?
  yearsExp      Int?
  categories    InterviewCategory[]
  creditRate    Int                 @default(1)
  creditBalance Int                 @default(0)

  availabilities        Availability[]
  bookingsAsInterviewee Booking[]           @relation("IntervieweeBookings")
  bookingsAsInterviewer Booking[]           @relation("InterviewerBookings")
  transactions          CreditTransaction[]
  sessionFeedback       SessionFeedback[]
  payouts               Payout[]
  aiConversations        AiConversation[]
}

// ─── AVAILABILITY ────────────────────────────────────────

model Availability {
  id            String             @id @default(uuid())
  interviewerId String
  interviewer   User               @relation(fields: [interviewerId], references: [id], onDelete: Cascade)
  startTime     DateTime
  endTime       DateTime
  status        AvailabilityStatus @default(AVAILABLE)

  @@index([interviewerId, startTime])
}

// ─── BOOKINGS ────────────────────────────────────────────

model Booking {
  id             String        @id @default(uuid())
  intervieweeId  String
  interviewee    User          @relation("IntervieweeBookings", fields: [intervieweeId], references: [id])
  interviewerId  String
  interviewer    User          @relation("InterviewerBookings", fields: [interviewerId], references: [id])
  startTime      DateTime
  endTime        DateTime
  category       InterviewCategory?
  status         BookingStatus @default(SCHEDULED)
  creditsCharged Int
  streamCallId   String?       @unique
  recordingUrl   String?
  feedback       Feedback?
  transactions   CreditTransaction[]
  sessionFeedback SessionFeedback?
  recordings     StreamRecording[]
  aiConversations AiConversation[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([interviewerId, status])
  @@index([intervieweeId, status])
}

// ─── FEEDBACK ────────────────────────────────────────────

model Feedback {
  id             String         @id @default(uuid())
  bookingId      String         @unique
  booking        Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  summary        String         @db.Text
  technical      String         @db.Text
  communication  String         @db.Text
  problemSolving String         @db.Text
  recommendation String
  strengths      String[]
  improvements   String[]
  overallRating  FeedbackRating
  sessionRating  Int?
  sessionComment String?        @db.Text
  createdAt      DateTime       @default(now())
}

model SessionFeedback {
  id            String   @id @default(uuid())
  bookingId     String   @unique
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  intervieweeId String
  interviewee   User     @relation(fields: [intervieweeId], references: [id], onDelete: Cascade)
  rating        Int
  comment       String?  @db.Text
  createdAt     DateTime @default(now())

  @@index([intervieweeId, createdAt])
}

model StreamRecording {
  id             String   @id @default(uuid())
  bookingId      String
  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  streamEgressId String   @unique
  recordingUrl   String
  readyAt        DateTime
  createdAt      DateTime @default(now())

  @@index([bookingId, readyAt])
}

// ─── CREDIT TRANSACTIONS ─────────────────────────────────

model CreditTransaction {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  type      TransactionType
  bookingId String?
  booking   Booking?        @relation(fields: [bookingId], references: [id])
  createdAt DateTime        @default(now())
}

// ─── PAYOUTS ─────────────────────────────────────────────

model Payout {
  id            String       @id @default(uuid())
  interviewerId String
  interviewer   User         @relation(fields: [interviewerId], references: [id], onDelete: Cascade)
  credits       Int
  platformFee   Float
  netAmount     Float
  paymentMethod String
  paymentDetail String
  status        PayoutStatus @default(PROCESSING)
  adminNote     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  processedAt   DateTime?
  processedBy   String?

  @@index([status, createdAt])
  @@index([interviewerId, status])
}

model EmailNotification {
  id          String   @id @default(uuid())
  key         String   @unique
  kind        String
  bookingId   String?
  recipient   String
  payload     Json
  scheduledFor DateTime
  status      String   @default("PENDING")
  attempts    Int      @default(0)
  sentAt      DateTime?
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, scheduledFor])
  @@index([bookingId, kind])
}

model AiConversation {
  id        String          @id @default(uuid())
  scopeKey  String          @unique
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingId String?
  booking   Booking?        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  category  InterviewCategory
  messages  AiChatMessage[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([userId, updatedAt])
  @@index([bookingId, userId])
}

model AiChatMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String         @db.Text
  clientMessageId String?
  replyToMessageId String?        @unique
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
  @@unique([conversationId, clientMessageId])
}


